# === REQUIRED: JWT secret ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-hex-string

# === REQUIRED for production (Render / Neon / Supabase) ===
# SQLite is used by default for local dev
# DATABASE_URL=postgresql://user:pass@host:5432/smartbiz

# === OPTIONAL: CORS ===
# Comma-separated frontend URLs for production
# CORS_ORIGINS=https://smartbiz-ai.vercel.app
CORS_ORIGINS=*

# === OPTIONAL: AI ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# === OPTIONAL: WhatsApp ===
# Must match the token you set in Meta Developer Console
WHATSAPP_VERIFY_TOKEN=smartbiz_verify_token
